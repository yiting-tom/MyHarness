# OpenRouter (Anthropic-compatible endpoint) — see spikes/RESULTS.md §Spike #3
OPENROUTER_KEY=sk-or-v1-...

# 自架 LiteLLM / OpenAI-compatible proxy — profile.SELF_HOSTED
HARNESS_PROXY_KEY=sk-...

# OpenAI-compatible endpoint reached WITHOUT the SDK (proxy 的直接路徑)。
# 三個都設才會註冊成 backend "direct"；沒有 key 的本機 vLLM 留空即可。
HARNESS_DIRECT_BASE_URL=http://host:8000
HARNESS_DIRECT_MODEL=model-name
HARNESS_DIRECT_KEY=

# 自架 Anthropic-compatible proxy 的位址與模型（SDK 路徑用）
HARNESS_PROXY_BASE_URL=http://host:4000
HARNESS_PROXY_MODEL=model-name
# 模型的 context window（token）。不設就當 200k；小於 200k 時 harness 會照比例
# 調低 CLI 的 auto-compact 門檻、lane 的閱讀量與 orchestrator 的交接點。
HARNESS_PROXY_CONTEXT_WINDOW=65536
